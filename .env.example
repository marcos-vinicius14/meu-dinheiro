# ==============================================================================
# Meu Dinheiro - Variáveis de Ambiente de Exemplo (.env.exemplo)
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente:
#   cp .env.exemplo .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados (PostgreSQL 18)
# Utilizado tanto pelo Docker Compose (compose.yaml) quanto pela API em Go
# ------------------------------------------------------------------------------
POSTGRES_USER=marcos
POSTGRES_PASSWORD=local_db
POSTGRES_DB=meu_dinheiro
POSTGRES_PORT=5432

# URL de conexão do jackc/pgx no formato postgresql://
DATABASE_URL=postgres://marcos:local_db@localhost:5432/meu_dinheiro?sslmode=disable

# ------------------------------------------------------------------------------
# 2. Configurações da API (apps/api)
# ------------------------------------------------------------------------------
# Porta onde o servidor HTTP em Go responderá
PORT=8080

# Chave secreta HMAC-SHA256 para assinatura dos cookies de sessão JWT
# Em produção, utilize uma string longa, criptograficamente segura e aleatória
JWT_SECRET=dev-secret-meu-dinheiro-super-secure-key-2026

# Username do seu bot no Telegram (sem o '@')
# Usado para gerar os deep links de login: tg://resolve?domain=<BOT_USERNAME>&start=auth_<token>
BOT_USERNAME=meu_dinheiro_bot

# Token secreto compartilhado entre o Bot e a API para proteger endpoints internos
# (/internal/auth/authorize-challenge)
INTERNAL_API_KEY=dev-internal-api-key-bot

# ------------------------------------------------------------------------------
# 3. Configurações do Bot do Telegram (apps/bot)
# ------------------------------------------------------------------------------
# Token de acesso fornecido pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_exemplo

# Endereço base da API REST para o bot enviar as confirmações de login
API_BASE_URL=http://localhost:8080

# (Opcional - Produção) Configuração de Webhook HTTPS
# Se WEBHOOK_URL não for informada, o bot opera automaticamente em modo Long Polling (ideal para desenvolvimento local)
# WEBHOOK_URL=https://bot.meudinheiro.com.br/webhook
# WEBHOOK_SECRET_TOKEN=chave-secreta-telegram-webhook-token-segura
# WEBHOOK_PORT=8081
# WEBHOOK_PATH=/webhook
